{
  "name": "artifree-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "An open workspace for agent-made artifacts. Initial scaffolding.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && npm run dev --workspace @artifree/web",
    "build:packages": "tsc -b packages/contracts packages/client packages/runtime-sdk apps/cli",
    "build:web": "npm run build --workspace @artifree/web",
    "build:architecture": "node scripts/build-architecture.mjs",
    "build": "npm run build:packages && npm run build:web && npm run build:architecture",
    "typecheck": "npm run build:packages && npm run typecheck --workspace @artifree/web && tsc -p docs/architecture/tsconfig.json",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/generate-contracts.mjs --check",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:rust": "node scripts/check-rust.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run check:contracts && npm run check:boundaries && npm run check:architecture && npm run typecheck && npm run test:tooling && npm run check:rust",
    "cli": "node apps/cli/dist/main.js",
    "test:smoke": "node scripts/smoke.mjs",
    "lint:code": "oxlint --deny-warnings",
    "lint:css": "stylelint \"apps/web/src/**/*.css\" \"docs/architecture/**/*.css\" --max-warnings 0",
    "lint": "npm run lint:code && npm run lint:css",
    "check:architecture": "node scripts/build-architecture.mjs --check",
    "test:tooling": "node --test --test-timeout=180000 scripts/tests/*.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@shadcn/lint": "0.2.3",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "oxc-parser": "0.155.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
